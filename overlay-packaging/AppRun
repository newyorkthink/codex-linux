#!/bin/bash
set -euo pipefail

resolve_appdir() {
    local source="${BASH_SOURCE[0]}"
    local dir

    while [ -L "$source" ]; do
        dir="$(cd -P "$(dirname "$source")" && pwd)"
        source="$(readlink "$source")"
        case "$source" in
            /*) ;;
            *) source="$dir/$source" ;;
        esac
    done

    cd -P "$(dirname "$source")" && pwd
}

APPDIR="${APPDIR:-$(resolve_appdir)}"
export APPDIR

# Register the AppImage identity before Electron creates its first X11 window.
# User-level XDG files let window lists resolve WM_CLASS=codex-desktop to the
# bundled icon without root access or any i3 configuration change.
integrate_user_desktop() {
    [ -n "${HOME:-}" ] || return 0
    [ -f "$APPDIR/__PACKAGE_NAME__.desktop" ] || return 0
    [ -f "$APPDIR/__PACKAGE_NAME__.png" ] || return 0

    local data_home="${XDG_DATA_HOME:-$HOME/.local/share}"
    local applications_dir="$data_home/applications"
    local icon_dir="$data_home/icons/hicolor/256x256/apps"
    local desktop_target="$applications_dir/__PACKAGE_NAME__.desktop"
    local icon_target="$icon_dir/__PACKAGE_NAME__.png"
    local desktop_tmp

    mkdir -p "$applications_dir" "$icon_dir"

    if [ ! -f "$icon_target" ] || ! cmp -s "$APPDIR/__PACKAGE_NAME__.png" "$icon_target"; then
        install -m 0644 "$APPDIR/__PACKAGE_NAME__.png" "$icon_target"
    fi

    desktop_tmp="$(mktemp "$applications_dir/.codex-desktop.XXXXXX")"
    if [ -n "${APPIMAGE:-}" ]; then
        local escaped_appimage="$APPIMAGE"
        escaped_appimage="${escaped_appimage//\\/\\\\}"
        escaped_appimage="${escaped_appimage//\"/\\\"}"
        escaped_appimage="${escaped_appimage//&/\\&}"
        escaped_appimage="${escaped_appimage//|/\\|}"
        sed \
            -e "s|^Exec=AppRun |Exec=\"$escaped_appimage\" |" \
            -e "s| AppRun --new-instance$| \"$escaped_appimage\" --new-instance|" \
            "$APPDIR/__PACKAGE_NAME__.desktop" > "$desktop_tmp"
    else
        cp "$APPDIR/__PACKAGE_NAME__.desktop" "$desktop_tmp"
    fi
    chmod 0644 "$desktop_tmp"

    if [ ! -f "$desktop_target" ] || ! cmp -s "$desktop_tmp" "$desktop_target"; then
        mv -f "$desktop_tmp" "$desktop_target"
    else
        rm -f "$desktop_tmp"
    fi
}

integrate_user_desktop || true

exec "$APPDIR/opt/__PACKAGE_NAME__/start.sh" "$@"
